# Flight Guide — environment variables
#
# Copy to `.env` and edit, or export the ones you need:
#
#   cp .env.example .env
#
# Nothing here is a secret. The prototype talks to no external service:
# there is no AI provider key, no database password, and no registry login.
# Do not add one to this file.

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------

# HOST PORT — the port on the host machine that maps to the app.
# Used by docker-compose.yml only. Default 8080.
# Open http://localhost:${HOST_PORT} after `docker compose up`.
HOST_PORT=8080

# PORT — the port the app listens on *inside* the container.
# Leave at 8080 unless you also change the compose mapping.
PORT=8080

# HOST — interface to bind inside the container.
# 0.0.0.0 is required for the port mapping to work. Do not set 127.0.0.1.
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# FG_DATA_DIR — directory holding settings.json and conversations.json.
# This must be the path backed by the volume in docker-compose.yml (/data),
# otherwise /admin edits are lost when the container is replaced.
FG_DATA_DIR=/data

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# FG_VERSION — free-text build label, returned by GET /healthz.
# Useful for confirming which build a server is running.
FG_VERSION=prototype

# FG_MAX_CONVERSATIONS — how many chat turns /admin keeps.
# Oldest entries are dropped first. 200 is roughly a day of demo traffic.
FG_MAX_CONVERSATIONS=200

# FG_MAX_BODY_BYTES — largest accepted request body, in bytes.
# 65536 (64 KiB) is far more than one chat message needs.
FG_MAX_BODY_BYTES=65536

# ---------------------------------------------------------------------------
# Not configurable here, on purpose
# ---------------------------------------------------------------------------
#
# - AI provider keys:   the response engine is rule-based and deterministic.
#                       See src/engine.js — that file is the swap point for a
#                       future LLM call.
# - Okal agent endpoint: no HTTP API exists for Okal agents. Do not add
#                       one; the container is self-contained.
# - Escalation minutes, profiles, stage text, map visibility:
#                       these live in /admin and are persisted to FG_DATA_DIR,
#                       not in the environment. That is what makes them
#                       editable at runtime by a non-technical operator.
