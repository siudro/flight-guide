# =============================================================================
# Flight Guide — LOCAL SECRETS  (this file is git-ignored)
# =============================================================================
#
#  ┌─────────────────────────────────────────────────────────────────────┐
#  │  PASTE YOUR OPENAI API KEY ON THE LINE BELOW AND NOWHERE ELSE.      │
#  └─────────────────────────────────────────────────────────────────────┘
#
#  Step 1:  copy the template once
#               cp app/.env.example app/.env
#
#  Step 2:  open `app/.env` and replace the placeholder after
#           OPENAI_API_KEY=   with your real key (starts sk-...)
#
#  Step 3:  start the app normally — it reads this file on boot
#               cd app && npm start
#
#  You should see this near the top of the boot log:
#               [env] loaded .env  (4 variables applied)
#               Mode ......... LLM WRITES REPLIES  (OpenAI)
#               Key .......... sk-pro…MNMA   from env
#
#  HOW THIS STAYS SAFE
#   * `.env` is in .gitignore, so `git add -A` cannot stage it.
#   * docker build copies only package.json, src/, config/ and public/ — never
#     .env — so the key is not baked into an image.
#   * The key never reaches the browser. /api/settings reports only whether a
#     key exists, never its value.
#   * It is never logged in full: only the first 6 and last 4 characters.
#
#  DO NOT commit this file. If it ever appears in `git status`, stop.
# =============================================================================

# Your OpenAI key. Starts with sk-...   (paste it after the =, no quotes)
OPENAI_API_KEY=sk-REPLACE_ME_WITH_YOUR_KEY

# Which model to use. gpt-4o-mini is cheap and can read images (ticket photos).
OPENAI_MODEL=gpt-4o-mini

# Turn the model on. Set to 0 to use only the rule engine.
LLM_ENABLED=1

# Seconds to wait for the provider before falling back to the rule engine.
LLM_TIMEOUT_MS=15000
